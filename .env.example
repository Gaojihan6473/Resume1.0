# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_EDGE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1
# Resume Agent is enabled by default on the client.
# Set this to false only when an environment needs an emergency rollback.
VITE_RESUME_AGENT_ENABLED=true
# Optional in dev: Vite serves /render-resume-pdf on the same origin.
# Set this in production or when using the standalone PDF render service.
# VITE_PDF_RENDER_URL=http://127.0.0.1:8787/render-resume-pdf

# Edge Functions - server-side only
MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_API_URL=https://api.minimaxi.com/v1/chat/completions
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESUME_AGENT_ENABLED=true
# Optional comma-separated browser origins allowed by auth Edge Functions.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# PDF render service - server-side only
PDF_RENDER_PORT=8787
PDF_RENDER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to false only for isolated local debugging.
# PDF_RENDER_REQUIRE_AUTH=false
